<html>

<head>
<style>

body {
  font-family: Arial, Helvetica, sans-serif;
  margin: 20px;
  color: #333333;
}

.report-container {
  width: 90%;
  margin: 0 auto;
}

.title {
  text-align: center;
  font-size: 22px;
  font-weight: bold;
  color: #003366;
  background-color: #f2f4f7;
  padding: 12px;
  border-radius: 4px;
  margin-bottom: 15px;
}

.section-title {
  margin-top: 20px;
  margin-bottom: 10px;
  font-size: 18px;
  font-weight: bold;
  color: #003366;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
}

th {
  background-color: #d9e2f3;
  border: 1px solid #c0c0c0;
  padding: 10px;
  text-align: center;
}

td {
  border: 1px solid #d6d6d6;
  padding: 8px;
  text-align: center;
}

tr:nth-child(even) {
  background-color: #f8f9fb;
}

.validation-message {
  margin-top: 20px;
  padding: 15px;
  border: 1px solid #c0c0c0;
  background-color: #f8f9fb;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
}

.validation-success {
  color: green;
  background-color: #eaf6ea;
  border: 1px solid #8bc48b;
}

.validation-failed {
  color: red;
  background-color: #fdeaea;
  border: 1px solid #e09a9a;
}

.footer {
  text-align: center;
  font-size: 12px;
  color: #666666;
  margin-top: 15px;
}

</style>
</head>

<body>

<div class="report-container">

  <div class="title">
    Database Available Patches - {{ ansible_date_time.date }}
  </div>

  <div class="section-title">
    Database Available Patches
  </div>

  <table>

    <thead>
      <tr>
        <th>DB System</th>
        <th>DB Home</th>
        <th>Update Description</th>
        <th>Version</th>
        <th>Last Action</th>
        <th>Release Date</th>
      </tr>
    </thead>

    <tbody>

    {% for item in db_updates.results %}

      {% if item.db_home_patches is defined %}

        {% for patch in item.db_home_patches %}

        <tr>

          <td>
            {{ item.item.item }}
          </td>

          <td>
            {{ item.item.db_homes[0].display_name | default('N/A') }}
          </td>

          <td>
            {{ patch.description | default('N/A') }}
          </td>

          <td>
            {{ patch.version | default('N/A') }}
          </td>

          <td>
            {{ patch.last_action | default('N/A', true) }}
          </td>

          <td>
            {{ patch.time_released | default('N/A') }}
          </td>

        </tr>

        {% endfor %}

      {% endif %}

    {% endfor %}

    </tbody>

  </table>


  <!-- DB PATCH VALIDATION -->

  {% if db_patch_available %}

  <div class="validation-message validation-success">
    Configured DB patch version
    {{ db_patch_version }}
    is available in OCI.
    Proceeding with DB precheck.
  </div>

  {% else %}

  <div class="validation-message validation-failed">
    Configured DB patch version
    {{ db_patch_version }}
    is not available in OCI.
    DB precheck cannot proceed.
  </div>

  {% endif %}


  <br>
  <br>

  <div class="footer">
    Report generated by OLAM Automation
  </div>

</div>

</body>

</html>
