<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>DB PRECHECK Report</title>
  <style>
    body { font: 14px Arial, sans-serif; color: #222; margin: 24px; }
    h1 { color: #17365d; font-size: 22px; }
    h2 { color: #17365d; font-size: 17px; margin-top: 24px; }
    .summary { padding: 12px; border: 1px solid #bbb; background: #f5f7fa; }
    .success { color: #176b35; font-weight: bold; }
    .failure { color: #a12622; font-weight: bold; }
    table { border-collapse: collapse; width: 100%; margin-top: 10px; }
    th, td { border: 1px solid #c8cdd3; padding: 8px; text-align: left; vertical-align: top; }
    th { background: #e8edf3; }
    tr:nth-child(even) { background: #f8f9fb; }
    .footer { color: #666; font-size: 12px; margin-top: 24px; }
  </style>
</head>
<body>
  {% set selected_patch = (target_patch | default([]) | first) | default({}) %}
  {% set history = latest_precheck | default({}) %}
  {% set history_state = history.lifecycle_state | default('NOT_FOUND') %}

  <h1>Database Home PRECHECK Report</h1>
  <div class="summary">
    <div><strong>Target group:</strong> {{ target | default('N/A') | e }}</div>
    <div><strong>Region:</strong> {{ target_region | default('N/A', true) | e }}</div>
    <div><strong>Patch version:</strong> {{ target_patch_version | default('N/A') | e }}</div>
    <div><strong>Patch ID:</strong> {{ target_patch_id | default('N/A', true) | e }}</div>
    <div>
      <strong>Latest history state:</strong>
      {% if history_state == 'SUCCEEDED' %}
        <span class="success">{{ history_state | e }}</span>
      {% else %}
        <span class="failure">{{ history_state | e }}</span>
      {% endif %}
    </div>
    <div><strong>Validation:</strong>
      {% if history_state == 'SUCCEEDED' %}
        <span class="success">PRECHECK succeeded</span>
      {% else %}
        <span class="failure">PRECHECK failed or no matching history was found</span>
      {% endif %}
    </div>
  </div>

  <h2>Selected OCI Patch</h2>
  <table>
    <thead><tr><th>Version</th><th>Description</th><th>Available actions</th></tr></thead>
    <tbody>
      {% if selected_patch %}
      <tr>
        <td>{{ selected_patch.version | default('N/A') | e }}</td>
        <td>{{ selected_patch.description | default('N/A') | e }}</td>
        <td>{{ selected_patch.available_actions | default([]) | join(', ') | e }}</td>
      </tr>
      {% else %}
      <tr><td colspan="3">The configured patch version was not found in the OCI patch response.</td></tr>
      {% endif %}
    </tbody>
  </table>

  <h2>PRECHECK Operation Responses</h2>
  <table>
    <thead><tr><th>DB Home ID</th><th>Database</th><th>Inventory host</th><th>Task result</th><th>Message</th></tr></thead>
    <tbody>
      {% for operation in (db_home_precheck_result.results | default([])) %}
        {% set operation_item = operation.item | default({}) %}
        {% set databases = operation_item.databases | default([]) %}
        {% set database = (databases | first) | default({}) %}
        {% set home_result = operation_item.item | default({}) %}
        <tr>
          <td>{{ database.db_home_id | default('N/A') | e }}</td>
          <td>{{ database.db_name | default('N/A') | e }}</td>
          <td>{{ home_result.item | default('N/A') | e }}</td>
          <td>
            {% if operation.skipped | default(false) %}SKIPPED
            {% elif operation.failed | default(false) %}FAILED
            {% else %}SUBMITTED{% endif %}
          </td>
          <td>{{ operation.msg | default('See OCI patch history for the final lifecycle state.') | e }}</td>
        </tr>
      {% else %}
      <tr><td colspan="5">No PRECHECK operation response was recorded.</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Matching PRECHECK History</h2>
  <table>
    <thead><tr><th>History ID</th><th>Patch ID</th><th>Action</th><th>State</th><th>Started</th><th>Ended</th></tr></thead>
    <tbody>
      {% for entry in (precheck_entries | default([])) %}
      <tr>
        <td>{{ entry.id | default('N/A') | e }}</td>
        <td>{{ entry.patch_id | default('N/A') | e }}</td>
        <td>{{ entry.action | default('N/A') | e }}</td>
        <td>{{ entry.lifecycle_state | default('N/A') | e }}</td>
        <td>{{ entry.time_started | default('N/A') | e }}</td>
        <td>{{ entry.time_ended | default('N/A') | e }}</td>
      </tr>
      {% else %}
      <tr><td colspan="6">No PRECHECK history entries matched the target patch.</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="footer">Generated by the DBCS DB PRECHECK Ansible workflow.</div>
</body>
</html>
